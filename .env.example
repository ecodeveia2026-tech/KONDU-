# ==============================================================================
# ŋdzemɔ — EXEMPLE DE VARIABLES D'ENVIRONNEMENT (POUR DÉVELOPPEMENT & VERCEL)
# Ne jamais inscrire de vraies clés secrètes dans ce fichier !
# ==============================================================================

# URL publique de votre projet Supabase
VITE_SUPABASE_URL=https://votre-projet.supabase.co

# Clé anonyme publique Supabase (Autorisée côté navigateur)
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# ==============================================================================
# VARIABLES SERVEUR UNIQUEMENT (Vercel Serverless Functions)
# ⚠️ NE JAMAIS préfixer par VITE_ — elles ne doivent PAS être dans le frontend
# ==============================================================================

# Supabase Service Role Key (pour opérations serveur / webhook)
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# PayDunya — Clés API (disponibles dans votre dashboard PayDunya)
PAYDUNYA_MASTER_KEY=votre-master-key
PAYDUNYA_PRIVATE_KEY=votre-private-key
PAYDUNYA_TOKEN=votre-token
PAYDUNYA_MODE=test
